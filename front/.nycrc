{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 80,
  "include": ["src/**/*.ts"],
  "exclude": [
    "coverage/**",
    "cypress/**",
    "dist/**",
    "**/*.spec.ts",
    "**/*.int.spec.ts",
    "src/main.ts",
    "src/test.ts",
    "src/polyfills.ts",
    "src/environments/**",
    "src/**/models/**",
    "src/**/index.ts",
    "src/app/shared/ui/material.ts"
  ],
  "report-dir": "coverage/cypress",
  "reporter": ["html", "text"]
}
