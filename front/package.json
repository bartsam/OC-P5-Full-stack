{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e:coverage": "npm run e2e:_clean && sh -c 'cleanup() { status=$?; trap - EXIT INT TERM; npm run e2e:_db:down; exit $status; }; trap cleanup EXIT; trap \"exit 130\" INT TERM; npm run e2e:_run:coverage'",
    "e2e:open": "sh -c 'cleanup() { status=$?; trap - EXIT INT TERM; npm run e2e:_db:down; exit $status; }; trap cleanup EXIT; trap \"exit 130\" INT TERM; npm run e2e:_db:up && start-server-and-test e2e:_back http://localhost:8081/v3/api-docs e2e:_open'",
    "e2e:_clean": "rm -rf .nyc_output coverage/cypress",
    "e2e:_run:coverage": "npm run e2e:_db:up && start-server-and-test e2e:_back http://localhost:8081/v3/api-docs e2e:_serve:coverage http://localhost:4201 e2e:_cypress",
    "e2e:_serve:coverage": "ng run front:cypress-coverage-build && http-server dist/front-e2e-coverage/browser -a localhost -p 4201 -c-1 -s -P http://localhost:4201?",
    "e2e:_db:up": "docker compose --project-name mdd-e2e --env-file ../back/.env -f ../back/compose.e2e.yml up -d --wait",
    "e2e:_db:down": "docker compose --project-name mdd-e2e --env-file ../back/.env -f ../back/compose.e2e.yml down -v",
    "e2e:_back": "cd ../back && sh ./mvnw spring-boot:run -Dspring-boot.run.profiles=e2e",
    "e2e:_cypress": "ELECTRON_RUN_AS_NODE= cypress run --browser chrome --config baseUrl=http://localhost:4201",
    "e2e:_open": "ELECTRON_RUN_AS_NODE= ng run front:cypress-open"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/router": "^22.1.3",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "^22.0.1",
    "@angular/build": "^22.1.5",
    "@angular/cli": "~22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@cypress/code-coverage": "^4.0.3",
    "@cypress/schematic": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.1.0",
    "cypress": "16.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
