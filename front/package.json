{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "npm run e2e:coverage",
    "e2e:open": "cypress open --expose coverage=false",
    "cypress:run": "cypress run --expose coverage=false",
    "cypress:run:coverage": "cypress run --config baseUrl=http://127.0.0.1:4201",
    "build:e2e:coverage": "ng run front:cypress-coverage-build",
    "start:e2e:coverage": "npm run build:e2e:coverage && http-server dist/front-e2e-coverage/browser -a 127.0.0.1 -p 4201 -c-1 -s",
    "clean:e2e:coverage": "rm -rf .nyc_output",
    "e2e:coverage": "npm run clean:e2e:coverage && start-server-and-test start:e2e:coverage http://127.0.0.1:4201 cypress:run:coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/router": "^22.1.3",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "^22.0.1",
    "@angular/build": "^22.1.5",
    "@angular/cli": "~22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@cypress/code-coverage": "^4.0.3",
    "@cypress/schematic": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.1.0",
    "cypress": "16.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
